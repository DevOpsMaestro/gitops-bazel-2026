load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Bazel entry points for cluster operations, replacing the old Makefile.
#
# Run `bazel run //:help` for the full list. Each target is a thin sh_binary
# wrapper around the corresponding script in scripts/ — the scripts remain
# the source of truth for behavior; Bazel just gives a single `bazel run
# //:<target>` entry point instead of `make <target>`.
#
# Scripts cd to $BUILD_WORKSPACE_DIRECTORY (set by `bazel run`) so they always
# operate on the real working tree rather than the Bazel sandbox/runfiles copy
# — required since several of them mutate real files (e.g. iperf3-enable) or
# read host state outside the workspace (e.g. ~/.config/sops).

sh_binary(
    name = "help",
    srcs = ["scripts/help.sh"],
)

sh_binary(
    name = "bootstrap",
    srcs = ["scripts/setup-fluxcd-gitops-kind-multinode.sh"],
)

sh_binary(
    name = "destroy",
    srcs = ["scripts/destroy.sh"],
)

sh_binary(
    name = "branch",
    srcs = ["scripts/set-flux-branch.sh"],
)

